# ==========================================
# SAKOL UNIVERSE — SERVER ENVIRONMENT CONFIG
# ==========================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Database Connection (Individual Fields)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sakol_universe
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Alternatively: Full Database Connection URL
# DATABASE_URL=postgres://user:password@host:5432/sakol_universe

# Authentication / JWT
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend Client Origin (for CORS)
CLIENT_URL=http://localhost:5173
# Production may use comma-separated approved browser origins.

# Cloudinary Storage (for Avatars, Resumes & Company Logos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
